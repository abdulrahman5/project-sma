# Copy to .env for local development. On Vercel, add these under Project → Settings → Environment Variables.

# Postgres connection string (Neon: use the "pooled" connection string)
DATABASE_URL=postgres://sma:sma@localhost:5432/sma

# Long random string used to sign admin login sessions. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me

# Public address of the site, without trailing slash. Optional on Vercel: if unset, Vercel's production
# domain is used automatically (your custom domain once it is attached, otherwise the .vercel.app address).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Blob (photo storage). Added automatically when you connect a Blob store in Vercel.
# Leave empty locally: uploads are then saved to the ./media folder instead.
BLOB_READ_WRITE_TOKEN=

# Resend (password-reset emails and contact-form alerts). Leave empty locally: emails are printed to the console.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Office of Hon. Saidu Musa Abdullahi
